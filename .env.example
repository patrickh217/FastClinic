# FastClinic — environment template.
# Copy to .env and fill in. Values live in Infisical; this file carries NAMES ONLY.
# There is no database here — MedBackend is the system of record.

# ---------------------------------------------------------------- cockpit
ENVIRONMENT=development                  # development | staging | production
FASTCLINIC_SECRET=                       # session signing key
FASTCLINIC_PORT=5005
FASTCLINIC_PUBLIC_URL=http://localhost:5005
FASTCLINIC_TODAY=                        # optional: pin "today" for demos, ISO date

# ---------------------------------------------------------------- MedBackend
# Discover these with:  GET /projects/{project_uid}/connection-info  on medbackend-app
# (Authentik bearer token). Prefer discovery over hardcoding.
MEDBACKEND_PROJECT_ID=                   # sent as the X-Project-ID header on every call
MEDBACKEND_GRAPHQL_URL=https://dev-backbone.medbackend.com/graphql
MEDBACKEND_APP_URL=https://dev-api.medbackend.com
MEDBACKEND_OAUTH_URL=https://dev-auth.medbackend.com

# One OAuth client per user flow; max two per project. client_id is derived and public.
# client_secret is issued ONCE at user-flow creation and CANNOT be rotated - keep it in
# Infisical, never in a file, and treat losing it as needing a new user flow.
MEDBACKEND_PRACTITIONER_CLIENT_ID=
MEDBACKEND_PRACTITIONER_CLIENT_SECRET=
MEDBACKEND_PATIENT_CLIENT_ID=
MEDBACKEND_PATIENT_CLIENT_SECRET=

# Must be byte-identical between /login and /token, and present in the flow's
# allowed_redirect_uris (exact string match, no wildcards). Declared ONCE - the old
# .env.sample assigned this twice and the empty second assignment silently won.
MEDBACKEND_REDIRECT_URI=http://localhost:5005/auth/callback

MEDBACKEND_TIMEOUT_SECONDS=30
MEDBACKEND_MAX_RETRIES=3
MEDBACKEND_LIVE_TEST=0                   # 1 enables the live e2e suite

# ---------------------------------------------------------------- AI copilot
MODEL_PROVIDER=xai                       # xai | openai | anthropic | google
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FASTCLINIC_CHAT_HISTORY_MESSAGES=20      # session-scoped; nothing is persisted
FASTCLINIC_CHAT_HISTORY_CHARS=8000

# ---------------------------------------------------------------- outreach
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VOODOO_SMS_API_KEY=
VOODOO_SMS_SENDER=
POSTMARK_API_TOKEN=
POSTMARK_FROM=
EMAIL_REPLY_TO=

# ---------------------------------------------------------------- SEO suite
FASTCLINIC_SEO_SITE=

# ---------------------------------------------------------------- secrets source
INFISICAL_URL=
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
